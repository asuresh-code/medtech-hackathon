# Copy to .env.local (git-ignored) and fill in. Never commit real keys.
# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=
# Server-only (Vercel functions + scripts). Never prefix with VITE_.
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=

# Text-to-speech, build-time only (npm run voice). One of:
OPENAI_API_KEY=
ELEVENLABS_API_KEY=

# Web Push: npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:aluna-demo@example.com
CRON_SECRET=
